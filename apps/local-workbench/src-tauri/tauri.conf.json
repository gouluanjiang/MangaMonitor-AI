{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaMonitor Dev",
  "version": "1.0.1",
  "identifier": "com.mangamonitor.workbench.preview",
  "build": {
    "beforeDevCommand": "pnpm dev --port 4173 --strictPort",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MangaMonitor",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main-workbench", "reader-workbench"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:4173 ws://127.0.0.1:4173; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "MangaMonitor desktop application",
    "longDescription": "Source browsing, local ZIP libraries, reading and explicitly confirmed local downloads.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../docs/USER_GUIDE.md": "USER_GUIDE.md",
      "../../../docs/RELEASE_NOTES_1.0.1.md": "RELEASE_NOTES.md",
      "release-resources/licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
